{%- liquid
  assign desk = collections[section.settings.collection]
  if desk == blank
    assign desk = collections['pictorial-book-window']
  endif
  if desk == blank
    assign desk = collections['frontpage']
  endif
-%}
<section class="teko-section" id="desk">
  <div class="teko-section-head">
    <p class="teko-kicker">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.title }}</h2>
  </div>
  <div class="teko-grid">
    {% if desk and desk.products_count > 0 %}
      {% for product in desk.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      {% for product in collections.all.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "In stock" },
    { "type": "text", "id": "title", "label": "Title", "default": "The desk" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Limit", "min": 2, "max": 12, "step": 1, "default": 4 }
  ]
}
{% endschema %}
