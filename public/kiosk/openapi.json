    "/api/v1/hal/card-dispenser/issue": {
      "post": {
        "tags": [
          "hal"
        ],
        "summary": "Move encoded card from RF station to the take-out mouth",
        "description": "將已編碼房卡從讀寫位送到取卡口 [notebook-attributed] creator: Creator K750-B serial/USB HID motor + IR sensors",
        "operationId": "api_v1_hal_card-dispenser_issue_post",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request / business rule"
          },
          "409": {
            "description": "Conflict"
          },
          "503": {
            "description": "Hardware or upstream unavailable"
          }
        }
      }
    },
