[{"code":"IF01","name":"主导产业类型","unit":"无","sourceType":"INDUSTRY","timeGranularity":"yearly","dimension":"产业功能","module":"产业结构与主导功能","definition":"研究范围内主要导入或实际集聚的产业门类、主导业态方向或功能类型，用于识别片区主导发展方向","required":true,"dependsOn":"","category":"产业结构与主导功能"},{"code":"IF02","name":"一级产业类别","unit":"无","sourceType":"INDUSTRY","timeGranularity":"yearly","dimension":"产业功能","module":"产业结构与主导功能","definition":"对研究范围主导产业或业态方向进行标准化归类后形成的一级产业类别","required":true,"dependsOn":"IF01","category":"产业结构与主导功能"},{"code":"IF03","name":"生活性服务业配套度","unit":"个/万人、个/km²","sourceType":"SUPPORTING","timeGranularity":"monthly","dimension":"产业功能","module":"产业结构与主导功能","definition":"研究范围内商业零售、餐饮服务、教育、医疗、文体休闲等生活性服务业设施的配置完整性和服务支撑水平","required":true,"dependsOn":"","category":"产业结构与主导功能"},{"code":"IF04","name":"功能复合度","unit":"指数","sourceType":"SUPPORTING","timeGranularity":"yearly","dimension":"产业功能","module":"产业结构与主导功能","definition":"","required":true,"dependsOn":"","category":"产业结构与主导功能"},{"code":"IF05","name":"城市微更新既有建筑改造比例","unit":"%","sourceType":"MAP_CHANGE","timeGranularity":"cumulative","dimension":"产业功能","module":"碳中和策略","definition":"指研究范围内纳入城市微更新、保护修缮、功能提升、立面整治、内部改造、加固更新、用途转换等更新行动的既有建筑，在全部既有建筑中的面积占比或栋数占比。通过上传不同时期卫星/航拍影像对比，AI视觉识别建筑变化估算改造比例。计算公式：既有建筑改造比例=已改造既有建筑面积/既有建筑总面积×100%","required":false,"dependsOn":"","category":"碳中和策略"},{"code":"IF06","name":"低碳策略","unit":"项/类","sourceType":"WEB","timeGranularity":"cumulative","dimension":"产业功能","module":"碳中和策略","definition":"指研究范围内项目或案例在建筑、能源、交通、公共空间、资源利用及运营管理等方面已实施或明确提出的减碳措施及策略类型，用于反映片区绿色低碳更新水平与减排导向。统计案例已实施或明确提出的低碳措施项数，并按建筑、能源、交通、空间、运营等维度统计覆盖类别数。从国家发改委政策页面、碳排放交易所网站爬取低碳策略数据。","required":true,"dependsOn":"","category":"碳中和策略"},{"code":"IF07","name":"低影响开发(LID)措施","unit":"类、项、㎡、m³、吨/年","sourceType":"WEB","timeGranularity":"cumulative","dimension":"产业功能","module":"碳中和策略","definition":"指研究范围内在海绵城市、雨洪管理、景观生态和公共空间建设中采用的低影响开发措施类型、数量及应用范围，包括透水铺装、下凹式绿地、雨水花园、植草沟、调蓄设施、生态驳岸、雨水回收等，用于反映片区生态韧性与雨洪调节能力。从海绵城市试点公示网站爬取LID措施数据。","required":true,"dependsOn":"","category":"碳中和策略"},